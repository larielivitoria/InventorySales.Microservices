{
  "Routes": [
    {
      "DownstreamPathTemplate": "/pedido/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5169
        }
      ],
      "UpstreamPathTemplate": "/vendas/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "SwaggerKey": "pedido",
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": []
      }
    },

    {
      "DownstreamPathTemplate": "/produto/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5079
        }
      ],
      "UpstreamPathTemplate": "/estoque/{everything}",
      "UpstreamHttpMethod": [ "GET" ],
      "SwaggerKey": "produto"
    },
    {
      "DownstreamPathTemplate": "/produto/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5079
        }
      ],
      "UpstreamPathTemplate": "/estoque/{everything}",
      "UpstreamHttpMethod": [ "POST", "PUT", "DELETE" ],
      "SwaggerKey": "produto",
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": []
      }
    }
  ],

  "SwaggerEndPoints": [
    {
      "Key": "pedido",
      "Config": [
        {
          "Name": "Microsserviço de Vendas",
          "Version": "v1",
          "Url": "http://localhost:5169/swagger/v1/swagger.json"
        }
      ]
    },
    {
      "Key": "produto",
      "Config": [
        {
          "Name": "Microsserviço de Estoque",
          "Version": "v1",
          "Url": "http://localhost:5079/swagger/v1/swagger.json"
        }
      ]
    }
  ],

  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:5096"
  }
}